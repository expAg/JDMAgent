# JDM API
JDM_BASE_URL=https://jdm-api.demo.lirmm.fr
JDM_TIMEOUT=15
JDM_CACHE_DIR=.cache/jdm
JDM_CACHE_TTL_META=604800   # 7 jours pour relation_types / node_types
JDM_CACHE_TTL_DATA=3600     # 1h pour nodes/relations

# LLM (agnostique via langchain.chat_models.init_chat_model)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
# Provider-specific keys:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Providers additionnels (utilises pour la rotation de cles cote HF Space) :
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Token du provider gratuit utilisé dans l'onglet Agent de la démo HF
# (les visiteurs ne fournissent rien — le quota est partagé entre eux).
# Sur HF Spaces : à mettre dans Settings → Variables & secrets.
# En dev local : créer le token et le coller ici.

# Google Gemini — seul provider gratuit avec un quota assez large pour notre
# prompt agent (~15-20K tokens par appel à cause des 34 outils sérialisés).
# Crée la clé sur https://aistudio.google.com/apikey (compte Google suffit,
# pas de carte bancaire). Free tier Gemini 2.5 Flash en mid-2026 :
#   ~10 requêtes/minute · ~250 000 tokens/minute · ~250 requêtes/jour
# Tableau de bord usage : https://aistudio.google.com/app/usage
GOOGLE_API_KEY=

# Providers gratuits retirés du dropdown — leurs free tiers ne suffisent pas
# pour notre prompt agent (~19-20 K tokens / appel à cause des 34 outils).
# Décommenter si tier payant souscrit.
#
# Groq : TPM free trop bas (6 K pour 8B, 12 K pour 70B < 19 K).
# Dashboard : https://console.groq.com/settings/billing
# (GROQ_API_KEY est defini plus haut dans la section provider keys)
#
# HF Inference Providers : crédits free ~0.10 $/mois, épuisés en quelques
# requêtes. HF Pro 9 $/mois → 2 $ de crédits.
# HF_TOKEN=

# Soumission automatique LLMDrops (Phase 12)
# Laisse JDM_DROPS_API_KEY vide pour désactiver l'upload (le fichier local
# reste écrit dans tous les cas). L'URL par défaut convient en prod.
JDM_DROPS_API_KEY=
JDM_DROPS_URL=http://jeuxdemots.org/LLMDrops.php
